# ======================
# RESOLVEX Backend Configuration
# ======================
# Copy this to .env and fill in actual values
# Never commit .env - only .env.example

# ======================
# SERVER
# ======================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ======================
# DATABASE (MongoDB)
# ======================
MONGODB_URI=mongodb://atlas-sql-69ac545a7f876f9874ec4caf-4g1lbm.a.query.mongodb.net/resolvex?ssl=true&authSource=admin

# ======================
# JWT AUTHENTICATION
# ======================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=7d

# ======================
# CLOUDINARY FILE UPLOADS
# ======================
# Get from: https://cloudinary.com/
# Create free account, go to Dashboard, copy credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# ======================
# EMAIL NOTIFICATIONS (Nodemailer)
# ======================
# Option 1: Gmail App Password (recommended for Gmail)
# 1. Go to myaccount.google.com
# 2. Enable 2-Factor Authentication
# 3. Go to myaccount.google.com/apppasswords
# 4. Select Mail > Windows Computer
# 5. Copy 16-char password (remove spaces)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=noreply@resolvex.edu

# Option 2: Use Mailtrap for development/testing
# 1. Sign up at: https://mailtrap.io
# 2. Get SMTP settings from your inbox
# EMAIL_HOST=live.smtp.mailtrap.io
# EMAIL_PORT=587
# EMAIL_USER=your-mailtrap-username
# EMAIL_PASS=your-mailtrap-password

# Option 3: Outlook/Microsoft 365
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@outlook.com
# EMAIL_PASS=your-outlook-password

# ======================
# FIREBASE (Real-time Notifications)
# ======================
# Generate service account JSON:
# 1. Go to: https://console.firebase.google.com/
# 2. Create new project (or use existing)
# 3. Project Settings > Service Accounts > Generate private key
# 4. Save JSON to: backend/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# ======================
# RATE LIMITING
# ======================
# General API: 100 requests per 15 minutes per IP
# Auth endpoints: 10 requests per 15 minutes per IP
# (Configured in server.js - no env vars needed)

# ======================
# DATABASE SECURITY
# ======================
# SSL/TLS for MySQL connections
# Development: rejectUnauthorized=false (self-signed certs allowed)
# Production: rejectUnauthorized=true (verified certs required)
# (Configured in config/db.js - no env vars needed)


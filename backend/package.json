{
  "name": "campusconnect-backend",
  "version": "1.0.0",
  "description": "CampusConnect - Campus Complaint and Maintenance Management System API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "create-db": "node scripts/create-db.js",
    "view-data": "node scripts/view-data.js",
    "seed": "node seeds/seed.js",
    "test": "jest --forceExit --detectOpenHandles --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^11.11.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "mongoose": "^8.0.0",
    "natural": "^6.7.0",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "routes/**/*.js",
      "services/**/*.js",
      "middleware/**/*.js",
      "!node_modules/**"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}

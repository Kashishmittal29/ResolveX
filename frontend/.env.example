# ======================
# CAMPUSCONNECT Frontend Configuration
# ======================
# Copy this to .env.local and fill in actual values
# Never commit .env.local - only .env.example

# Note: All Vite env vars must start with VITE_

# ======================
# API CONFIGURATION
# ======================
VITE_API_BASE_URL=http://localhost:5001/api
VITE_APP_NAME=CampusConnect

# Production only — set this on Vercel to your Render backend URL
# VITE_API_URL=https://your-app.onrender.com/api

# ======================
# FIREBASE (Real-time Notifications)
# ======================
# Get from: https://console.firebase.google.com/
# Project Settings > Your Apps > Web App > Copy config

# Minimum required:
VITE_FIREBASE_API_KEY=AIzaSyD...
VITE_FIREBASE_PROJECT_ID=campusconnect-xyz
VITE_FIREBASE_APP_ID=1:123456:web:abc...

# Optional (full config):
# VITE_FIREBASE_AUTH_DOMAIN=campusconnect-xyz.firebaseapp.com
# VITE_FIREBASE_DATABASE_URL=https://campusconnect-xyz.firebaseio.com
# VITE_FIREBASE_STORAGE_BUCKET=campusconnect-xyz.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789

# ======================
# FEATURE FLAGS (Optional)
# ======================
VITE_ENABLE_FIREBASE=true
VITE_ENABLE_REAL_TIME_NOTIFICATIONS=true
VITE_DEBUG_MODE=false
